        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-26" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" value="клиенты" vertex="1">
          <mxGeometry height="31" width="60" x="510" y="2102" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-27" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;" value="Zoiper — это софтфон.&#xa;&#xa;Zoiper умеет:&#xa;открывать карточку клиента при входящем звонкепоказывать информацию по номерулогировать звонки&#xa;В продажах и поддержке это крайне полезно.&#xa;&#xa;" vertex="1">
          <mxGeometry height="250" width="160" x="510" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-28" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" value="IP-АТС" vertex="1">
          <mxGeometry height="30" width="60" x="744" y="2102" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-29" parent="1" style="text;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;" value="Asterisk, FreePBX, 3CX, Mango, Zadarma и т.д." vertex="1">
          <mxGeometry height="40" width="290" x="746.5" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-30" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" value="MicroSIP&#xa;Платформа: только Windows&#xa;Цена: бесплатный&#xa;&#xa;" vertex="1">
          <mxGeometry height="70" width="180" x="510" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-31" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;" value="FreePBX — это бесплатная веб-панель для управления Asterisk, которая превращает сложный VoIP-движок в удобную «коробочную» IP-АТС.&#xa;Сам Asterisk — мощный, но требует ручной конфигурации.&#xa;FreePBX делает это простым: кликаешь кнопками → получаешь готовую IP-телефонию." vertex="1">
          <mxGeometry height="233" width="270" x="746.5" y="2210" as="geometry" />
        </mxCell>
