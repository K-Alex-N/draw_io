        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;" value="относиться к прикладному уровню модели OSI&lt;div&gt;не предают данные&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="121.19" width="390" x="3520" y="380" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;" value="acknowledge -&amp;nbsp;признавать, подтверждать" vertex="1">
          <mxGeometry height="35.83" width="260" x="20" y="874.17" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-25" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
