        <mxCell id="K-6UtHccNFK5HgkNZUim-26" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" value="клиенты" vertex="1">
          <mxGeometry height="31" width="60" x="510" y="2102" as="geometry" />
