        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-18" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="68.73" width="322" x="2600" y="170" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-19" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="290" width="204.24" x="2980" y="83.25" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;" value="TCP не используется т.к. если потерялся пакет то нет смысла его запрашивать по новой - это будет долго, разговор уже дальше уйдет.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Так же всякие дополнительные перепроверки в TCP накладывают ненужную &quot;тяжесть&quot; для передачи и задержки&lt;/div&gt;" vertex="1">
          <mxGeometry height="121.19" width="390" x="3250" y="88.81" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-21" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
