        <mxCell id="K-6UtHccNFK5HgkNZUim-19" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;align=left;whiteSpace=wrap;" value="" vertex="1">
