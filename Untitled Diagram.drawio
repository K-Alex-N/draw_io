        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-30" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" value="MicroSIP&#xa;Платформа: только Windows&#xa;Цена: бесплатный&#xa;&#xa;" vertex="1">
          <mxGeometry height="70" width="180" x="510" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-31" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;" value="FreePBX — это бесплатная веб-панель для управления Asterisk, которая превращает сложный VoIP-движок в удобную «коробочную» IP-АТС.&#xa;Сам Asterisk — мощный, но требует ручной конфигурации.&#xa;FreePBX делает это простым: кликаешь кнопками → получаешь готовую IP-телефонию." vertex="1">
          <mxGeometry height="233" width="270" x="746.5" y="2210" as="geometry" />
