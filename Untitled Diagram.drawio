        <mxCell id="K-6UtHccNFK5HgkNZUim-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;rounded=0;" value="выставляет временные метки каждому пакету.&amp;nbsp;&lt;br&gt;А принимающая сторона восстанавливает правильный порядок" vertex="1">
