        <mxCell id="K-6UtHccNFK5HgkNZUim-27" parent="1" style="text;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;" value="Zoiper — это софтфон.&#xa;&#xa;Zoiper умеет:&#xa;открывать карточку клиента при входящем звонкепоказывать информацию по номерулогировать звонки&#xa;В продажах и поддержке это крайне полезно.&#xa;&#xa;" vertex="1">
          <mxGeometry height="250" width="160" x="510" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="K-6UtHccNFK5HgkNZUim-28" parent="1" style="text;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" value="IP-АТС" vertex="1">
